DATABASE_URL=postgresql+psycopg://driveclean:driveclean@localhost:5432/driveclean
FRONTEND_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Archive extraction: files uploaded at the same time per archive (more fills a fast connection).
# ARCHIVE_UPLOAD_WORKERS=12
# Lets the organizer read file contents and suggest topic folders (Medical, Education, ...).
# By default a small local model in Ollama (docker compose runs it and pulls the model), so nothing leaves
# your machine. A native backend reaches it at localhost; in docker compose the URL is set for you.
CLASSIFIER_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_NUM_CTX=8192
# Or the Claude API:
# CLASSIFIER_PROVIDER=anthropic
# CLASSIFIER_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=
# Or Claude in Microsoft Foundry: CLASSIFIER_MODEL is your deployment name, and the resource is the
# <resource> in https://<resource>.services.ai.azure.com (or set ANTHROPIC_FOUNDRY_BASE_URL instead).
# CLASSIFIER_PROVIDER=foundry
# CLASSIFIER_MODEL=claude-haiku-4-5
# ANTHROPIC_FOUNDRY_RESOURCE=
# ANTHROPIC_FOUNDRY_API_KEY=
# Thinking effort; empty turns it off (needed for a deployment of Haiku 4.5 or Sonnet 4.5 named otherwise).
# CLASSIFIER_EFFORT=low
